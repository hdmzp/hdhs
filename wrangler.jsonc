// Cloudflare Worker 설정 - 텔레그램 알림 신청 봇 (worker/telegram-bot.js, 설명은 worker/README.md)
// Cloudflare 의 hdhs-bot 이 이 저장소와 연결돼 있어서 main 에 push 될 때마다 자동으로 다시 배포된다.
// 이 파일이 없으면 저장소 전체가 웹사이트로 배포돼 봇 코드가 덮어써진다.
// BOT_TOKEN 은 Cloudflare 대시보드의 Secret 에 넣는다 (여기 적지 않는다).
{
  "name": "hdhs-bot",
  "main": "worker/telegram-bot.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "ADMIN_ID": "8921978250"
  },
  // 신청·승인 상태 저장공간. id 를 비워 두면 첫 배포 때 Cloudflare 가 알아서 만든다.
  "kv_namespaces": [
    { "binding": "SUBS" }
  ],
  // 아침 발송 시계 (UTC). KST 05:30 셀럽PGM 수집 / 06:15 실패 시 재수집 / 07:00 아침 알림.
  // GITHUB_TOKEN (Secret) 이 있어야 GitHub 에 실행을 요청할 수 있다. 처리: telegram-bot.js 의 onCron
  "triggers": {
    "crons": ["30 20 * * *", "15 21 * * *", "0 22 * * *"]
  }
}
